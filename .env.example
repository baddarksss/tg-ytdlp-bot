# ============================================================================
#  tg-ytdlp-bot · نمونهٔ متغیرهای محیطی
#
#  روی Railway: سرویس → Variables → Raw Editor → همین خطوط را کپی کن و مقدار بده.
#  برای اجرای لوکال/داکر: این فایل را به .env کپی کن.
#
#  ⚠️ فقط ۳ مورد اول اجباری است. بقیه اختیاری‌اند و اگر نگذاری، مقدار پیش‌فرض
#     داخل برنامه استفاده می‌شود.
# ============================================================================

# ── ۱) اجباری ───────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # از @BotFather
API_ID=12345678                                           # از my.telegram.org
API_HASH=0123456789abcdef0123456789abcdef                 # از my.telegram.org

# ── ۲) مهم (بدون این‌ها ربات کار می‌کند ولی ناقص) ───────────────────────────
BOT_NAME=tgytdlp-bot                     # نام داخلی
BOT_NAME_FOR_USERS=tgytdlp_bot           # نام در دیتابیس (یوزرنیم ربات بدون @)
ADMIN=123456789                          # آیدی عددی خودت (چند نفر: با کاما)
ADMIN_USERNAME=@your_username
LOGS_ID=-1001234567890                   # کانال لاگ اصلی
LOG_EXCEPTION=-1001234567890             # کانال خطاها (می‌تواند همان بالا باشد)
LOGS_VIDEO_ID=-1001234567890
LOGS_NSFW_ID=-1001234567890
LOGS_IMG_ID=-1001234567890
LOGS_PAID_ID=-1001234567890

# کپیِ تمیزِ فیلم در کانال (بدون برچسبِ «Forwarded from») — کپشن همان کپشنِ کاربر
# می‌توانی چند کانال با کاما بگذاری: -100111…,-100222…  یا @a,@b
# خالی/0 = خاموش. ربات باید در آن کانال‌ها ادمین باشد (اجازهٔ ارسال پیام).
COPY_CHANNEL_ID=
# 1 (پیش‌فرض) = بعد از هر آپلود، دکمهٔ کانال‌ها زیرِ فیلم می‌آید تا خودت انتخاب کنی
# 0 = بی‌سؤال، فیلم در اولین کانال کپی می‌شود
COPY_CHANNEL_ASK=1
# توکنِ API ریلوی (اختیاری) برای دکمهٔ «ذخیره در Variables»
RAILWAY_API_TOKEN=
# 1 = هر تغییرِ کانال خودکار در COPY_CHANNEL_ID نوشته شود
CHANNEL_AUTOSYNC=0
TZ=Asia/Tehran

# ── ۳) گروه‌ها و دسترسی ─────────────────────────────────────────────────────
ADMIN_GROUP=-1001234567890               # گروه‌هایی که محدودیت ندارند
ALLOWED_GROUP=-1001234567890             # گروه‌های مجاز
ALLOWED_USERS=                           # خالی = همه می‌توانند از ربات استفاده کنند
MINIAPP_URL=https://t.me/tgytdlp_bot/?startapp
STAR_RECEIVER=7360853

# ── ۴) عضویت اجباری در کانال (اختیاری) ─────────────────────────────────────
SUBSCRIBE_CHANNEL=0                      # 0 = غیرفعال
SUBSCRIBE_CHANNEL_URL=
CHANNEL_GUARD_SESSION_STRING=            # فقط اگر از ChannelGuard استفاده می‌کنی

# ── ۵) کوکی‌ها ──────────────────────────────────────────────────────────────
# بدون کوکی، یوتیوب محدود می‌کند (کیفیت پایین / خطای «ربات هستی»).
# سه راه داری:
#   الف) همین متغیر: محتوای فایل کوکی (Netscape). چندخطی هم اشکالی ندارد.
#        اگر محتوا را base64 کرده‌ای: COOKIES_CONTENT=base64:PGNvbnRlbnQ+
#   ب) در تلگرام فایل کوکی را برای ربات بفرست (/cookie) — در Volume می‌ماند.
#   ج) یک آدرس اینترنتی که فایل .txt کوکی می‌دهد.
COOKIES_CONTENT=
YOUTUBE_COOKIES_CONTENT=                 # اگر پر باشد، بر COOKIES_CONTENT اولویت دارد
COOKIE_URL=
YOUTUBE_COOKIE_URL=
YOUTUBE_COOKIE_ORDER=round_robin         # round_robin یا random
INSTAGRAM_COOKIE_URL=
TIKTOK_COOKIE_URL=
TWITTER_COOKIE_URL=
VK_COOKIE_URL=
# YOUTUBE_COOKIE_URL_1= ... تا _10

# ── ۶) یوتیوب: PO Token (توصیه‌شده) ────────────────────────────────────────
# برای کیفیت بالا (720p+) و کم‌شدن خطاهای یوتیوب. حدود ۳۰۰ مگ رم بیشتر می‌خواهد.
YOUTUBE_POT_ENABLED=false
YOUTUBE_POT_BASE_URL=http://127.0.0.1:4416
YOUTUBE_POT_DISABLE_INNERTUBE=false

# ── ۷) پروکسی (اختیاری) ────────────────────────────────────────────────────
PROXY_TYPE=socks5
PROXY_IP=
PROXY_PORT=1080
PROXY_USER=
PROXY_PASSWORD=
PROXY_SELECT=round_robin

# ── ۸) منابع و محدودیت‌ها (برای پلن‌های کوچک پایین‌تر بگذار) ────────────────
MAX_FILE_SIZE_GB=2                       # حداکثر حجم هر فایل
MAX_CONCURRENT_DOWNLOADS=2               # دانلود همزمان هر کاربر
MAX_CONCURRENT_UPLOADS=2                 # آپلود همزمان به تلگرام
TG_YTDLP_BG_WORKERS=8                    # تعداد ورکر پس‌زمینه
TG_YTDLP_BG_INFLIGHT=80
DOWNLOAD_TIMEOUT=7200
MAX_VIDEO_DURATION=43200
MAX_PLAYLIST_COUNT=50
MAX_SUB_QUALITY=720
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=60
RATE_LIMIT_PER_DAY=1000
TURN_OFF_LIMITS_FOR_ADMINS=true

# ── ۹) دیتابیس (پیش‌فرض: لوکال روی Volume — نیازی به تغییر نیست) ───────────
USE_FIREBASE=false
# FIREBASE_CONF={"apiKey":"...","databaseURL":"https://....firebaseio.com","projectId":"..."}
# FIREBASE_SERVICE_ACCOUNT=/data/service-account.json

# ── ۱۰) زیرساخت (Railway خودش PORT می‌دهد) ─────────────────────────────────
DATA_DIR=/data                           # همان مسیر Volume؛ دست نزن
# PORT=8080                              # Railway خودش ست می‌کند (سرور سلامت)
HEALTH_STRICT=false                      # true = اگر ربات خواب باشد /ready خطای 503 بدهد
VERBOSE_LOGGING=false
